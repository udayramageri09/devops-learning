#include <tunables/global>

profile devops-lab-profile flags=(attach_disconnected,mediate_deleted) {
    /** rwklmix,

    network inet stream,
    network inet6 stream,

    capability net_bind_service,
    deny capability sys_admin,

    deny /etc/** r,
    deny /var/** w,
    deny /bin/** x,
    deny /usr/bin/** x,
}
